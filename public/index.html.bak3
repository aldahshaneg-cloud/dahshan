<a class="wa" id="waFab" target="_blank" rel="noopener" aria-label="واتساب">
  <svg viewBox="0 0 24 24"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Z"/></svg>
</a>

<script src="assets/js/api.js"></script>
<script>
/* الموقع العام — REST بالكامل، بدون فايربيز:
   المحتوى من /api/settings/site و /api/partners، التغطية من /api/public/coverage،
   التتبّع من /api/track/{num}، وطلب الانضمام لـ /api/public/join-request. */
const FALLBACK = { phone:"01000000000", whatsapp:"201000000000", email:"info@aldahshan.com", hours:"يوميًا من 9 ص إلى 11 م" };
const INFO = { ...FALLBACK };

const $ = id => document.getElementById(id);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]));
$("yr").textContent = new Date().getFullYear();

function applyInfo() {
  const wa = `https://wa.me/${INFO.whatsapp}`;
  $("cTel").textContent = INFO.phone;  $("cTel").href = "tel:" + INFO.phone;
  const realPhone = INFO.phone && INFO.phone !== FALLBACK.phone;
  $("hdrTel").style.display = realPhone ? "" : "none";
  if (realPhone) { $("hdrTelNum").textContent = INFO.phone; $("hdrTel").href = "tel:" + INFO.phone; }
  $("cWa").textContent  = "+" + INFO.whatsapp; $("cWa").href = wa;
  $("cMail").textContent = INFO.email; $("cMail").href = "mailto:" + INFO.email;
  $("cHours").textContent = INFO.hours;
  $("waFab").href = wa;
  $("storeWa").href = wa + "?text=" + encodeURIComponent("السلام عليكم، عايز أسجّل محلي مع الدهشان");
  $("storeTel").href = "tel:" + INFO.phone;
}
applyInfo();

const HERO_DEF = { title: $("heroTitle").innerHTML, sub: $("heroSub").textContent };
const APP_DEF = {
  customer: { icon:"📱", name:"تطبيق العملاء", def:"customer.html", desc:"سجّل طلبك، تابعه لحظيًا، واحفظ عناوينك ومستلمينك.", label:"تحميل التطبيق" },
  pilot   : { icon:"🛵", name:"تطبيق الطيار",  def:"", desc:"للطيارين: استلام الطلبات، الخريطة، والورديات.", label:"تحميل التطبيق" },
  store   : { icon:"🏪", name:"برنامج المحلات", def:"store.html", desc:"لأصحاب المحلات: سجّل شحناتك وتابع تحصيلاتك وتقفيلاتك.", label:"تحميل التطبيق" }
};
function withInstallFlag(url, key) {
  if (key !== "customer" && key !== "store") return url;
  if (!url || /^https?:/i.test(url)) return url;
  if (/[?&]install=1/.test(url)) return url;
  return url + (url.includes("?") ? "&" : "?") + "install=1";
}
function renderApps(cfg) {
  $("appsGrid").innerHTML = Object.entries(APP_DEF).map(([k, d]) => {
    const v = cfg?.[k] || {};
    if (v.on === false) return "";
    const url = withInstallFlag((v.url || d.def || "").trim(), k);
    const label = (v.label || d.label).trim();
    return `<div class="app-card"><div class="ic">${d.icon}</div><h3>${esc(d.name)}</h3><p>${esc(d.desc)}</p>${
      url ? `<a class="go" href="${esc(url)}"${/^https?:/i.test(url) ? ' target="_blank" rel="noopener"' : ""}>${esc(label)}</a>` : `<div class="soon">قريبًا</div>`}</div>`;
  }).join("");
}
function renderPartners(list, title) {
  const arr = (list || []).slice().sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
  const sec = $("partners");
  if (!arr.length) { sec.style.display = "none"; return; }
  sec.style.display = "";
  if (title) $("partnersTitle").textContent = title;
  $("partnersGrid").innerHTML = arr.map(p => {
    const inner = `<div class="lg ${p.logo ? "" : "none"}">${p.logo ? `<img src="${esc(p.logo)}" alt="${esc(p.name || "")}" loading="lazy" />` : "🏢"}</div><b>${esc(p.name || "—")}</b>${p.desc ? `<span>${esc(p.desc)}</span>` : ""}`;
    const safe = /^https:\/\//i.test(p.url || "") ? p.url : "";
    return safe ? `<a class="p-item" href="${esc(safe)}" target="_blank" rel="noopener">${inner}</a>` : `<div class="p-item">${inner}</div>`;
  }).join("");
}

/* محتوى الموقع — GET /api/settings/site (info/apps/hero) + GET /api/partners */
(async () => {
  try {
    const [siteRes, partRes] = await Promise.all([
      API.get("/api/settings/site").catch(() => ({})),
      API.get("/api/partners").catch(() => ({ items: [] })),
    ]);
    const s = (siteRes.site && siteRes.site.site) || {};   // المحتوى تحت مفتاح site
    Object.assign(INFO, FALLBACK);
    for (const k of ["phone", "whatsapp", "email", "hours"]) if (s.info?.[k]) INFO[k] = s.info[k];
    applyInfo();
    renderApps(s.apps);
    renderPartners(partRes.items, s.hero?.partnersTitle);
    const t = (s.hero?.title || "").trim(), sb = (s.hero?.sub || "").trim();
    if (t) $("heroTitle").textContent = t; else $("heroTitle").innerHTML = HERO_DEF.title;
    $("heroSub").textContent = sb || HERO_DEF.sub;
  } catch (e) { console.warn("site content:", e); }
})();

/* ── القائمة على الموبايل ── */
$("burger").onclick = () => $("menu").classList.toggle("open");
document.querySelectorAll("#menu a").forEach(a => a.onclick = () => $("menu").classList.remove("open"));

/* ── خطوط السرعة ── */
(() => {
  const box = $("speed");
  for (let i = 0; i < 14; i++) {
    const el = document.createElement("i");
    el.style.top = (Math.random() * 100) + "%";
    el.style.width = (60 + Math.random() * 190) + "px";
    el.style.animationDuration = (2.6 + Math.random() * 3.6) + "s";
    el.style.animationDelay = (-Math.random() * 5) + "s";
    el.style.opacity = .18 + Math.random() * .5;
    box.appendChild(el);
  }
})();

/* ══ تتبّع الشحنة — GET /api/track/{num} (بيانات مقنّعة من السيرفر) ══ */
const STEPS = [
  { label: "تم استلام الطلب", hint: "سجّلنا شحنتك ووصلت للفرع" },
  { label: "جاري التوصيل",    hint: "الطيار في الطريق للمستلم" },
  { label: "تم التسليم",      hint: "وصلت للمستلم بنجاح" }
];
const PILL = {
  "قيد التنفيذ":["p-new","قيد التنفيذ"], "جاري التوصيل":["p-way","جاري التوصيل"],
  "تم التسليم":["p-done","تم التسليم"], "لم يتم التوصيل":["p-fail","لم يتم التوصيل"], "ملغي":["p-cancel","ملغي"]
};
const fmtDate = iso => { if (!iso) return "—"; const d = new Date(iso); return isNaN(d) ? "—" : d.toLocaleDateString("ar-EG", { day:"numeric", month:"long", year:"numeric" }); };

function stageOf(status) {
  if (status === "ملغي") return -1;
  if (status === "تم التسليم") return 2;
  if (status === "لم يتم التوصيل") return 1;
  if (status === "جاري التوصيل") return 1;
  return 0;
}
function renderTrack(d) {
  const status = d.status || "قيد التنفيذ";
  const [cls, label] = PILL[status] || ["p-new", status || "—"];
  const stage = stageOf(status);
  const dead = (status === "ملغي" || status === "لم يتم التوصيل");
  const ps = d.parcels || [];
  const zones = [...new Set(ps.map(p => p.zoneName).filter(x => x && x !== "—"))].join("، ");
  const tl = STEPS.map((st, i) => {
    const on = !dead && i <= stage;
    const now = !dead && i === stage && stage < 2;
    return `<div class="tl-row ${on ? "on" : "off"} ${now ? "now" : ""}"><div class="dot"></div><div><b>${st.label}</b><span>${on ? st.hint : "لسه ما تمّتش"}</span></div></div>`;
  }).join("");
  $("result").innerHTML = `
    <div class="res-head"><div><div class="res-num">#${esc(d.orderNum)}</div>
      <div style="font-size:12.5px;color:var(--muted)">اتسجّلت ${fmtDate(d.createdAt)}</div></div>
      <span class="pill ${cls}">${esc(label)}</span></div>
    ${dead ? `<div class="err" style="margin-top:16px">${status === "ملغي" ? "الشحنة دي اتلغت." : "المحاولة الأخيرة للتسليم ماتمّتش — كلّمنا ونظبّطها."}</div>` : `<div class="tl">${tl}</div>`}
    <div class="res-grid">
      <div class="res-cell"><b>المستلم</b><span>${esc(ps[0]?.receiverName || "—")}</span></div>
      <div class="res-cell"><b>منطقة التسليم</b><span>${esc(zones || "—")}</span></div>
      <div class="res-cell"><b>عدد الطرود</b><span>${ps.length || 1}</span></div>
      <div class="res-cell"><b>الفرع</b><span>${esc(d.branch || "—")}</span></div>
    </div>
    <a href="customer.html?install=1&t=${encodeURIComponent(d.orderNum)}" style="display:flex;align-items:center;justify-content:center;gap:9px;margin-top:16px;background:var(--red);color:#fff;text-decoration:none;padding:14px;border-radius:13px;font-weight:800;font-size:14.5px">📲 حمّل التطبيق وتابع كل شحناتك</a>
    <div class="note">🔒 بنعرض حالة الشحنة بس. لأي تفاصيل تانية كلّم خدمة العملاء على <a href="tel:${INFO.phone}" style="color:var(--red);font-weight:800">${INFO.phone}</a></div>`;
  $("result").classList.add("on");
}

/* لينك الباركود: https://aldahshan.cloud/?track=CODE — الصفحة دي نفسها */
(function () {
  const code = new URLSearchParams(location.search).get("track");
  if (!code) return;
  document.addEventListener("DOMContentLoaded", () => {
    const inp = $("trackNum"); if (!inp) return;
    inp.value = code.toUpperCase();
    $("track")?.scrollIntoView({ behavior: "smooth", block: "center" });
    $("trackForm").dispatchEvent(new Event("submit", { cancelable: true }));
  });
})();

$("trackForm").addEventListener("submit", async e => {
  e.preventDefault();
  const num = $("trackNum").value.trim().toUpperCase();
  const box = $("result"), btn = $("trackBtn");
  if (!num) return;
  btn.disabled = true; btn.textContent = "…";
  box.className = "on";
  box.innerHTML = `<div style="text-align:center;color:var(--muted);padding:20px">⏳ بندوّر على شحنتك…</div>`;
  try {
    const d = await API.get("/api/track/" + encodeURIComponent(num));
    if (!d.found) {
      box.innerHTML = `<div class="err">مالقيناش شحنة بالرقم <b dir="ltr">${esc(num)}</b>.<br /><span style="font-weight:500;color:var(--muted);font-size:13px">راجع الرقم، أو كلّمنا على ${INFO.phone}</span></div>`;
      return;
    }
    renderTrack(d);
  } catch (err) {
    box.innerHTML = `<div class="err">تعذّر الاتصال دلوقتي — جرّب تاني بعد شوية.</div>`;
    console.error(err);
  } finally { btn.disabled = false; btn.textContent = "تتبّع"; }
});

/* ══ نافذة كل المناطق ══ */
function renderAllZones(q) {
  const grid = $("zonesAll"); if (!grid) return;
  const term = String(q || "").trim().toLowerCase();
  const list = (window._siteZones || []).filter(z => !term || z.name.toLowerCase().includes(term));
  grid.innerHTML = list.length
    ? list.map(z => `<div class="zm-item"><span>${esc(z.name)}</span>${z.price ? `<small>${z.price} ج.م</small>` : ""}</div>`).join("")
    : `<div class="zm-empty">مالقيناش منطقة بالاسم ده — كلّمنا على ${INFO.phone} ونشوفها لك</div>`;
}
window.filterZones = () => renderAllZones($("zonesSearch").value);
window.openZones = () => { $("zonesSearch").value = ""; renderAllZones(); $("zonesModal").classList.add("on"); document.body.style.overflow = "hidden"; setTimeout(() => $("zonesSearch").focus(), 80); };
window.closeZones = () => { $("zonesModal").classList.remove("on"); document.body.style.overflow = ""; };
document.addEventListener("keydown", e => { if (e.key === "Escape" && $("zonesModal")?.classList.contains("on")) closeZones(); });

/* ══ المناطق والفروع — GET /api/public/coverage ══ */
(async () => {
  try {
    const c = await API.get("/api/public/coverage");
    const zones = c.zones || [];
    const box = $("zones"), ZONES_SHOWN = 5;
    if (zones.length) {
      const list = zones.map(z => ({ name: z.name, price: z.price || 0 })).sort((a, b) => a.name.localeCompare(b.name, "ar"));
      window._siteZones = list;
      box.innerHTML = list.slice(0, ZONES_SHOWN).map(z => `<div class="zone">${esc(z.name)}${z.price ? `<small>${z.price} ج.م</small>` : ""}</div>`).join("");
      if (list.length > ZONES_SHOWN) { $("zonesMoreCount").textContent = `(+${list.length - ZONES_SHOWN})`; $("zonesMore").style.display = ""; }
      renderAllZones();
    } else {
      box.innerHTML = `<div class="zone">كلّمنا نقولك بنغطي منطقتك ولا لأ 📞</div>`;
    }
    $("stZones").textContent = zones.length || "—";
    if (c.branchCount) $("stBranches").textContent = c.branchCount;
  } catch (e) { console.warn("coverage:", e); }
})();

/* ══ تبويبات الانضمام ══ */
document.querySelectorAll(".tab").forEach(t => t.onclick = () => {
  document.querySelectorAll(".tab").forEach(x => x.classList.toggle("on", x === t));
  document.querySelectorAll(".pane").forEach(p => p.classList.toggle("on", p.id === "pane-" + t.dataset.p));
});

const validPhone = p => /^0?1[0-9]{9}$/.test(String(p || "").replace(/[\s-]/g, ""));
const say = (el, txt, ok) => { el.className = "msg on " + (ok ? "ok" : "bad"); el.textContent = txt; };

/* ══ طلب انضمام طيار — POST /api/public/join-request (الفرع بيحدده الإدارة عند القبول) ══ */
$("pilotForm").addEventListener("submit", async e => {
  e.preventDefault();
  const msg = $("pMsg"), btn = $("pBtn");
  const name = $("pName").value.trim(), phone1 = $("pPhone1").value.trim();
  const vehicleNo = $("pVehicle").value.trim(), address = $("pAddress").value.trim();
  if (!name)               return say(msg, "اكتب اسمك بالكامل", false);
  if (!validPhone(phone1)) return say(msg, "رقم الهاتف غير صحيح — لازم 11 رقم يبدأ بـ 01", false);
  if (!vehicleNo)          return say(msg, "اكتب رقم الموتوسيكل", false);
  if (!address)            return say(msg, "اكتب عنوانك", false);
  btn.disabled = true; btn.textContent = "⏳ بنبعت طلبك…";
  try {
    await API.post("/api/public/join-request", {
      name, phone1,
      phone2: $("pPhone2").value.trim(),
      cardNum: $("pCard").value.trim(),
      vehicleNo, address
    }, { quiet401: true });
    $("pilotForm").reset();
    say(msg, "✅ وصلنا طلبك! هنراجعه ونكلّمك على رقمك خلال يومين.", true);
  } catch (err) {
    say(msg, "تعذّر إرسال الطلب — جرّب تاني أو كلّمنا على " + INFO.phone, false);
    console.error(err);
  } finally { btn.disabled = false; btn.textContent = "إرسال الطلب"; }
});
</script>

</body>
</html>