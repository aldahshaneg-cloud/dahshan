# ═══════════════════════════════════════════════════════════════════
# .env للإنتاج — انسخه لـ .env على السيرفر وعدّل القيم المعلّمة بـ «غيّرني»
#
# ⚠️ الملف ده **مش** بيتحط في git. النسخة دي مثال بلا أسرار.
# ═══════════════════════════════════════════════════════════════════

APP_NAME=Dahshan
APP_ENV=production
APP_KEY=                              # غيّرني: php artisan key:generate
APP_DEBUG=false                       # 🔴 لازم false — true بيعرض الأسرار في صفحة الخطأ
APP_TIMEZONE=UTC                      # 🔴 التخزين كله UTC — متغيّرهاش
APP_URL=https://yourdomain.com        # غيّرني

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG

LOG_CHANNEL=stack
LOG_LEVEL=warning                     # في الإنتاج debug بيملا القرص

# ── قاعدة البيانات ───────────────────────────────────────────────
# 🔴 مستخدم مخصّص مش root. الصلاحيات المطلوبة:
#    SELECT, INSERT, UPDATE, DELETE على aldahshan بس.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aldahshan
DB_USERNAME=aldahshan                 # غيّرني
DB_PASSWORD=                          # غيّرني: باسورد قوي

# ── الجلسة ───────────────────────────────────────────────────────
# 🔴 اسم الكوكي جزء من العقد — الواجهات وتطبيق الطيار Flutter بيعتمدوا عليه.
#    تغييره = كل الجلسات المفتوحة تقع وتطبيق الطيار يطلب دخول تاني.
SESSION_DRIVER=database               # على الإنتاج database أحسن من file
SESSION_COOKIE=ALDAHSHAN_SESS
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true            # 🔴 true لأن الموقع HTTPS

# ── الكاش والمهام ────────────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── التحديث الفوري (Reverb) ──────────────────────────────────────
# سيبها log لحد ما الواجهات تتحوّل من الاستطلاع للدفع — شوف docs/REALTIME.md
BROADCAST_CONNECTION=log

REVERB_APP_ID=                        # غيّرني
REVERB_APP_KEY=                       # غيّرني
REVERB_APP_SECRET=                    # غيّرني
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=local

# ── رسالة الواتساب للمستلم (order_notifications) ─────────────────
# manual    = الافتراضي: المهمة بتسجّل الصف pending والموظف بيبعت بإيده
# cloud_api = إرسال تلقائي عن طريق Meta Cloud API
# 🔴 التحويل للتلقائي = السطر ده + الـ3 اللي تحته، وبعدها config:cache.
WHATSAPP_PROVIDER=manual
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# قالب Meta المعتمد — من غيره النص الحر بيترفض لأي مستلم بره نافذة 24 ساعة
WHATSAPP_TEMPLATE=

# ── إشعارات ستارة الهاتف لتطبيق العملاء (Web Push / VAPID) ──────────
# فاضي = الميزة متعطّلة بالكامل (المسارات بترد 503 والمهمة بتسكت).
# 🔴 الزوج بيتولّد **على السيرفر نفسه** — متنسخش مفاتيح التطوير هنا:
#   php -r "require 'vendor/autoload.php'; print_r(Minishlink\WebPush\VAPID::createVapidKeys());"
# وبعد ما تحطهم: php artisan config:cache
# 🔴 تغيير الزوج بعد التشغيل بيبطل كل اشتراكات العملاء القديمة.
VAPID_PUBLIC_KEY=                     # غيّرني
VAPID_PRIVATE_KEY=                    # غيّرني
VAPID_SUBJECT=mailto:info@aldahshan.cloud
