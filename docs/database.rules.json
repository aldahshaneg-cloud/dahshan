{
  "rules": {
    ".read": false,
    ".write": false,
    "adminEmails": {
      ".read": "auth != null",
      ".write": "auth != null && (!data.exists() || auth.token.email_verified == true)",
      "$entry": {
        ".validate": "newData.isString() && newData.val().length > 3"
      }
    },
    "storeDiag": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "counters": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "closings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "users": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "pilots": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "orders": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["orderNum", "pilotId"]
    },
    "customers": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "branches": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "shifts": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "zones": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "senders": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "receivers": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "attendance": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "payroll": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "expenses": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "manualEmployees": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "storeContacts": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "cashStores": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "cashTransactions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "custodyTransactions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "closingBranches": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "pilotJoinRequests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "pilotLeaveRequests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "pilotShiftRequests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "pilotReturnRequests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "pilotMonthlyCloseouts": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "pilotSupportRequests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "pilotTransfers": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "hr": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "cc": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "rd": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "accounting": {
      ".read": "auth != null",
      ".write": "auth != null",
      "accounts": {
        "$acc": {
          ".validate": "newData.hasChildren(['code','name','type'])"
        }
      },
      "journal": {
        "$entry": {
          ".validate": "newData.hasChildren(['date','lines','totalDebit','totalCredit'])",
          "totalDebit":  { ".validate": "newData.isNumber()" },
          "totalCredit": { ".validate": "newData.isNumber()" }
        }
      }
    }
  }
}
