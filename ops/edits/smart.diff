+  /** بيحط القايمة تحت حقلها (أو فوقه لو المساحة ضيقة) بنفس عرضه */
+  function positionSmart(box) {
+    const wrap = box.closest(".smart");
+    const inp  = wrap && wrap.querySelector("input");
+    if (!inp) return;
+
+    const r = inp.getBoundingClientRect();
+    const below = window.innerHeight - r.bottom - SMART_GAP;
+    const above = r.top - SMART_GAP;
+
+    /* الارتفاع الطبيعي للمحتوى — بنقيسه من غير سقف عشان نعرف هيحتاج قد إيه */
+    box.style.maxHeight = "none";
