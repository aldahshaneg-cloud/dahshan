+
+    // بتقلب فوق بس لو تحت مش كفاية **وفوق أوسع** — غير كده تحت أولى
+    const flip = below < Math.min(need, SMART_MIN) && above > below;
+    const space = Math.max(80, Math.floor(flip ? above : below));
+
+    box.style.width  = r.width + "px";
+    box.style.right  = (window.innerWidth - r.right) + "px";
+    box.style.left   = "auto";
+    box.style.maxHeight = Math.min(260, space) + "px";
+    box.style.top    = flip ? "auto" : (r.bottom + SMART_GAP) + "px";
+    box.style.bottom = flip ? (window.innerHeight - r.top + SMART_GAP) + "px" : "auto";
+    box.classList.toggle("flip", flip);
+  }
